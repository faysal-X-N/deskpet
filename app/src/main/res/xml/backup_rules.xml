<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 及以下的备份排除规则（allowBackup=false 已关闭备份，这里额外声明以备审阅） -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
</full-backup-content>
